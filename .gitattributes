# 换行符策略：仓库内存 LF，检出时由各平台决定
* text=auto

# Shell 脚本 / Maven 包装器必须保持 LF，否则在 Linux、macOS 下无法执行
*.sh  text eol=lf
mvnw  text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件（避免被当文本做换行转换）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.jar    binary
*.zip    binary
*.7z     binary
*.gz     binary

# SVG 是文本，保留
*.svg    text
