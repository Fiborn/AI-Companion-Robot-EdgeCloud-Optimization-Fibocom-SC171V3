# 环境变量模板
# 复制此文件为 .env，填入真实值（.env 已被 .gitignore 忽略，不会入库）

# ---------- MySQL 数据库（云端平台后端）----------
MYSQL_URL=jdbc:mysql://localhost:3306/iot_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password

# ---------- Redis（后端缓存 / 会话）----------
REDIS_PASSWORD=your_redis_password

# ---------- JWT 令牌签发密钥（后端，至少 32 位随机串）----------
TOKEN_SECRET=your_random_secret_at_least_32_chars

# ---------- 文件上传目录（后端 ruoyi.profile）----------
RUOYI_PROFILE=./ruoyi-ui/public/img/upload

# ---------- AI2 语音服务 ----------
AI2_ENV_PATH=../AI2/.env
AI2_ROOT=E:\path\to\AI2

# ---------- 小智语音链路 / MCP 接入点 ----------
MCP_ENDPOINT_DIR=E:\path\to\mcp-endpoint-server
IOT_PYTHON=python
